{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "out/{main,renderer}/index.js!",
    "src/main/index.ts",
    "src/renderer/index.ts",
    "src/**/*.test.ts",
    "test/**/*.ts"
  ],
  "project": ["*.ts", "build/**/*.ts", "src/**/*.ts", "test/**/*.ts", "e2e/scripts/**/*.mts", "out/**/*.js!"],
  "ignoreBinaries": ["kubectl"],
  "typescript": {
    "config": ["tsconfig.json"]
  },
  "vite": {
    "config": ["electron.vite.config.ts"]
  }
}
