{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",

  "entry": [
    "out/{main,renderer}/index.js!",
    "src/main/index.ts",
    "src/renderer/index.tsx",
    "src/**/*.test.{ts,tsx}",
    "test/**/*.{ts,tsx}",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  "project": [
    "*.ts",
    "build/**/*.ts",
    "src/**/*.{ts,tsx}",
    "test/**/*.{ts,tsx}",
    "e2e/scripts/**/*.mts",
    "out/**/*.js!"
  ],

  // electron-rebuild belongs to the Freelens checkout of the integration workflow
  "ignoreBinaries": ["electron-rebuild"],
  "ignoreDependencies": [
    // Named by the paths of tsconfig.json only: the types of the host, which the resolution of the
    // bundler does not find through the exports of the package.
    "@freelensapp/core"
  ],

  "typescript": {
    "config": ["tsconfig.json"]
  },
  // The configs are entries above. Left to its plugins, Knip takes the sources they
  // name as production entries and asks for the host SDK among the dependencies.
  "electron-vite": false,
  "vite": false,
  "vitest": false
}
