{
  "name": "@freelensapp/velero-extension",
  "version": "0.1.0-alpha.0",
  "description": "Freelens extension for Velero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freelensapp/freelens-velero-extension.git",
    "directory": "."
  },
  "main": "out/main/index.js",
  "renderer": "out/renderer/index.js",
  "files": [
    "out/main/**",
    "out/renderer/**"
  ],
  "engines": {
    "node": ">= 22.12.0",
    "freelens": "^1.10.3"
  },
  "copyright": "© 2025-2026 Freelens Authors",
  "license": "MIT",
  "author": {
    "name": "Freelens Authors",
    "email": "freelens@freelens.app"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "biome": "pnpm dlx @biomejs/biome@2.5.14",
    "biome:check": "pnpm biome check",
    "biome:fix": "pnpm biome check --fix",
    "biome:migrate": "pnpm biome migrate --write",
    "trunk": "pnpm dlx @trunkio/launcher@1.3.4",
    "trunk:check": "pnpm trunk check",
    "trunk:check:all": "pnpm trunk check --all",
    "trunk:fix": "pnpm trunk check --fix",
    "trunk:fix:all": "pnpm trunk check --fix --all",
    "lint": "pnpm lint:check",
    "lint:check": "pnpm biome:check",
    "lint:fix": "pnpm biome:fix",
    "knip": "pnpm dlx knip@6.39.0 --dependencies --no-gitignore",
    "knip:check": "pnpm \"/^knip:(development|production)\\$/\"",
    "knip:development": "pnpm knip",
    "knip:production": "pnpm knip --production --strict",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build && vitest run",
    "e2e": "pnpm build && node e2e/scripts/local-demo.mts fixtures --context kind-freelens-velero-dev && node e2e/scripts/local-demo.mts transport-proof --context kind-freelens-velero-dev",
    "e2e:cluster:up": "node e2e/scripts/local-demo.mts up --context kind-freelens-velero-dev",
    "e2e:cluster:down": "node e2e/scripts/local-demo.mts down --context kind-freelens-velero-dev",
    "demo:up": "pnpm e2e:cluster:up && node e2e/scripts/local-demo.mts fixtures-static --context kind-freelens-velero-dev && node e2e/scripts/local-demo.mts fixtures-live --context kind-freelens-velero-dev",
    "demo:views": "node e2e/scripts/local-demo.mts demo --context kind-freelens-velero-dev",
    "demo:down": "pnpm e2e:cluster:down",
    "e2e:views": "pnpm build:production && pnpm clean:tgz && pnpm pack && node e2e/scripts/local-demo.mts views --context kind-freelens-velero-dev",
    "pre-review": "E2E_TEST_PATTERN=pre-review pnpm e2e:views",
    "type:check": "tsc --noEmit -p tsconfig.json --composite false",
    "build": "pnpm type:check && electron-vite build",
    "build:production": "VITE_PRESERVE_MODULES=false pnpm build",
    "build:force": "electron-vite build",
    "bump-version": "pnpm version --no-commit-hooks --no-git-tag-version",
    "pack:dev": "pnpm bump-version prerelease && pnpm build:production && pnpm clean:tgz && pnpm pack && pnpm dlx shx@0.4.0 ls \"$PWD/*.tgz\"",
    "clean": "pnpm clean:out",
    "clean:node_modules": "pnpm dlx shx@0.4.0 rm -rf node_modules",
    "clean:out": "pnpm dlx shx@0.4.0 rm -rf out",
    "clean:tgz": "pnpm dlx shx@0.4.0 rm -f \"*.tgz\"",
    "clean:all": "pnpm \"/^clean:(node_modules|out|tgz)\\$/\"",
    "postupdate": "pnpm biome:migrate"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@freelensapp/core": "1.10.3",
    "@freelensapp/extensions": "1.10.3",
    "@kubernetes/client-node": "2.0.0",
    "@testing-library/react": "12.1.5",
    "@types/node": "24.12.4",
    "@types/react": "17.0.93",
    "@types/react-dom": "17.0.26",
    "@types/ws": "8.18.2",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.2",
    "mobx": "6.15.0",
    "mobx-react": "7.6.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "keywords": [
    "extension",
    "freelensapp",
    "lens",
    "openlens",
    "freelens",
    "velero",
    "backup",
    "restore",
    "kubernetes"
  ],
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6"
}
