{
  "name": "@freelensapp/velero-extension",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Velero backup and recovery tools for Freelens",
  "license": "MIT",
  "main": "out/main/index.js",
  "renderer": "out/renderer/index.js",
  "files": [
    "out/main/**",
    "out/renderer/**"
  ],
  "engines": {
    "node": ">=22.12.0",
    "freelens": "1.10.3"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "type:check": "tsc --noEmit -p tsconfig.json --composite false",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "lint:check": "pnpm biome:check",
    "lint:fix": "pnpm biome:fix",
    "trunk:check": "trunk check --all --no-progress",
    "trunk:fix": "trunk check --fix --all --no-progress",
    "knip:check": "pnpm knip:development && pnpm knip:production",
    "knip:development": "knip --dependencies --no-gitignore",
    "knip:production": "knip --dependencies --production --strict --no-gitignore",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build && vitest run",
    "build": "pnpm type:check && electron-vite build",
    "build:production": "VITE_PRESERVE_MODULES=false pnpm build",
    "pack:dev": "pnpm build && pnpm clean:tgz && pnpm pack",
    "clean": "shx rm -rf out",
    "clean:tgz": "shx rm -f \"*.tgz\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@freelensapp/extensions": "1.10.3",
    "@kubernetes/client-node": "2.0.0",
    "@trunkio/launcher": "1.3.4",
    "@types/node": "24.12.4",
    "@types/react": "17.0.93",
    "@types/ws": "8.18.1",
    "electron-vite": "5.0.0",
    "knip": "6.23.0",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "vite": "8.1.2",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  },
  "keywords": [
    "freelens",
    "freelensapp",
    "extension",
    "velero",
    "kubernetes",
    "backup",
    "restore"
  ]
}
