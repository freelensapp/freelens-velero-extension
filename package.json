{
  "name": "@freelensapp/velero-extension",
  "version": "0.1.0-alpha.0",
  "description": "Freelens extension for Velero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freelensapp/freelens-velero-extension.git",
    "directory": "."
  },
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">= 24.0.0",
    "freelens": "^2.0.0"
  },
  "copyright": "© 2025-2026 Freelens Authors",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Freelens Authors",
    "email": "freelens@freelens.app"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "biome": "pnpm dlx @biomejs/biome@2.5.15",
    "biome:check": "pnpm biome check",
    "biome:fix": "pnpm biome check --fix",
    "biome:migrate": "pnpm biome migrate --write",
    "trunk": "pnpm dlx @trunkio/launcher@1.3.4",
    "trunk:check": "pnpm trunk check",
    "trunk:check:all": "pnpm trunk check --all",
    "trunk:fix": "pnpm trunk check --fix",
    "trunk:fix:all": "pnpm trunk check --fix --all",
    "lint": "pnpm lint:check",
    "lint:check": "pnpm biome:check",
    "lint:fix": "pnpm biome:fix",
    "knip": "pnpm dlx knip@6.41.0 --dependencies --files --no-gitignore --no-config-hints",
    "knip:check": "pnpm \"/^knip:(development|production)\\$/\"",
    "knip:development": "pnpm knip",
    "knip:production": "pnpm knip --production --strict",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build && vitest run && vitest run --config test/measure.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "pnpm build && node e2e/scripts/local-demo.mts fixtures --context kind-freelens-velero-dev && node e2e/scripts/local-demo.mts transport-proof --context kind-freelens-velero-dev",
    "e2e:cluster:up": "node e2e/scripts/local-demo.mts up --context kind-freelens-velero-dev",
    "e2e:cluster:down": "node e2e/scripts/local-demo.mts down --context kind-freelens-velero-dev",
    "demo:up": "pnpm e2e:cluster:up && node e2e/scripts/local-demo.mts fixtures-static --context kind-freelens-velero-dev && node e2e/scripts/local-demo.mts fixtures-live --context kind-freelens-velero-dev",
    "demo:views": "node e2e/scripts/local-demo.mts demo --context kind-freelens-velero-dev",
    "demo:down": "pnpm e2e:cluster:down",
    "e2e:views": "pnpm build && pnpm clean:tgz && pnpm pack && node e2e/scripts/local-demo.mts views --context kind-freelens-velero-dev",
    "e2e:integration": "pnpm build && pnpm clean:tgz && pnpm pack && node e2e/scripts/local-demo.mts integration --context kind-freelens-velero-dev",
    "pre-review": "E2E_TEST_PATTERN=pre-review pnpm e2e:views",
    "type:check": "pnpm type:check:sources && pnpm type:check:tests && pnpm type:check:tooling && pnpm type:check:integration && pnpm type:check:scripts && pnpm type:check:environments",
    "type:check:sources": "tsc -p src/main && tsc -p src/renderer",
    "type:check:tests": "tsc -p src/tsconfig.json",
    "type:check:tooling": "tsc -p tsconfig.json",
    "type:check:integration": "tsc -p integration",
    "type:check:scripts": "tsc -p e2e/scripts",
    "type:check:environments": "tsc -p environment-tests/tsconfig.main.json && tsc -p environment-tests/tsconfig.renderer.json && tsc -p environment-tests",
    "build": "vite build && vite build --mode main",
    "dev": "pnpm \"/^dev:(renderer|main)\\$/\"",
    "dev:main": "vite build --watch --mode main",
    "dev:renderer": "vite build --watch --no-emptyOutDir",
    "bump-version": "pnpm version --no-commit-hooks --no-git-checks --no-git-tag-version",
    "pack:dev": "pnpm bump-version prerelease && pnpm build && pnpm clean:tgz && pnpm pack && pnpm dlx shx@0.4.0 ls \"$PWD/*.tgz\"",
    "clean": "pnpm clean:dist",
    "clean:dist": "pnpm dlx shx@0.4.0 rm -rf dist",
    "clean:dts": "pnpm dlx shx@0.4.0 rm -f \"src/**/*.d.css.ts\"",
    "clean:node_modules": "pnpm dlx shx@0.4.0 rm -rf node_modules",
    "clean:tgz": "pnpm dlx shx@0.4.0 rm -f \"*.tgz\"",
    "clean:all": "pnpm \"/^clean:(dist|dts|node_modules|tgz)\\$/\"",
    "postupdate": "pnpm biome:migrate"
  },
  "dependencies": {
    "react-window": "2.3.4"
  },
  "devDependencies": {
    "@freelensapp/extensions": "2.0.0-0-nightly-2026-10-23",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "43.8.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "extension",
    "freelensapp",
    "lens",
    "openlens",
    "freelens",
    "velero",
    "backup",
    "restore",
    "kubernetes"
  ],
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
