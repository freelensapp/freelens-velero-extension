{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "The configuration of the template of the extensions of Freelens, with the rules of this repository for the pins of its test environment.",
    "rangeStrategy: always bump dependencies, even when the new version is already in the range.",
    "rebaseWhen: rebase only on conflicts, to save unnecessary workflow runs.",
    "postUpdateOptions: pnpmDedupe dedupes pnpm-lock.yaml in Renovate's own commit, so an update lands without duplicates.",
    "internalChecksFilter: hold updates that do not yet satisfy minimumReleaseAge instead of raising a pending PR, which would run CI and fail pnpm's minimumReleaseAge policy.",
    "ignoreDeps: ubuntu must be the oldest possible version, for binary compatibility with older operating systems.",
    "customDatasources and the packageRules that use them: the libraries and tools that Freelens also has take the version Freelens has on main, not the newest release. See the packageRules for which ones. The custom datasources return one release, the version Freelens has, so those rules replace the current value rather than bump it: bump looks for the current version among the releases and skips a dependency with no lock file that it cannot find there."
  ],
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "prHourlyLimit": 20,
  "addLabels": ["renovate"],
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": ["pnpmDedupe"],
  "rangeStrategy": "bump",
  "vulnerabilityAlerts": {
    "description": "Security fixes must not be delayed by minimumReleaseAge.",
    "labels": ["security"],
    "rangeStrategy": "bump",
    "minimumReleaseAge": "0 days"
  },
  "rebaseWhen": "conflicted",
  "internalChecksFilter": "strict",
  "ignoreDeps": ["ubuntu"],
  "lockFileMaintenance": {
    "description": [
      "mise.lock pins a checksum and a URL per tool per platform, but a local `mise install` re-locks only the platform it runs on and silently leaves the other seven stale.",
      "Lock file maintenance runs plain `mise lock`, which refreshes every tool on every platform already in the file.",
      "Defaults are disabled and weekly, hence the explicit settings. The packageRules keep it to mise.lock, since pnpm-lock.yaml is updated with each dependency update and does not want a periodic refresh PR. mise-lock-check.yaml checks every such PR."
    ],
    "enabled": true,
    "schedule": ["at any time"],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "No lock file maintenance by default: pnpm-lock.yaml is updated with each dependency update.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    },
    {
      "description": "Lock file maintenance for mise.lock only.",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": true
    },
    {
      "description": "Delay npm updates until they satisfy pnpm's minimumReleaseAge policy (1 day by default since pnpm v11). Only npm packages land in pnpm-lock.yaml, so this is scoped to the npm datasource and leaves the other datasources untouched.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "25 hours"
    },
    {
      "description": "No delay for @freelensapp/extensions, which pnpm-workspace.yaml excludes from minimumReleaseAge.",
      "matchPackageNames": ["@freelensapp/extensions"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": [
        "Libraries that Freelens also has take the version of its default catalog in pnpm-workspace.yaml on main: the extension compiles and tests against the versions the host runs. react-window, the one library the bundle carries, is among them, in dependencies.",
        "Every dependency except the ones excluded with ! here: a dependency added to package.json is in the Freelens catalog unless it is added to that list. One that is in neither fails its lookup on the Dependency Dashboard.",
        "The custom datasource has no release dates, so minimumReleaseAge is off; Freelens has the same pnpm policy and adopts only versions that already satisfy it."
      ],
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchPackageNames": ["!@freelensapp/**"],
      "overrideDatasource": "custom.freelens-catalog",
      "rangeStrategy": "replace",
      "minimumReleaseAge": "0 days",
      "groupName": "Freelens dependencies"
    },
    {
      "description": "Tools run with pnpm dlx, and the Biome that Trunk runs, take the version Freelens runs with pnpm dlx in the scripts of its root package.json on main, except the ones excluded with ! here, which Freelens does not run. The custom datasource has no release dates, so minimumReleaseAge is off.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["package.json", ".trunk/trunk.yaml"],
      "matchDatasources": ["npm"],
      "matchPackageNames": ["!shx"],
      "overrideDatasource": "custom.freelens-dlx",
      "rangeStrategy": "replace",
      "minimumReleaseAge": "0 days",
      "groupName": "Freelens dependencies"
    },
    {
      "description": "The tools in mise.toml and Node in .nvmrc take the versions in mise.toml of Freelens on main, where Node is the version bundled in Electron. The mise manager expects a leading v in the releases of tools that come from GitHub, which mise.toml does not have, so extractVersion makes it optional. The custom datasource has no release dates, so minimumReleaseAge is off.",
      "matchManagers": ["mise", "nvm"],
      "overrideDatasource": "custom.freelens-mise",
      "overridePackageName": "{{depName}}",
      "extractVersion": "^v?(?<version>.+)$",
      "rangeStrategy": "replace",
      "minimumReleaseAge": "0 days",
      "groupName": "Freelens dependencies"
    },
    {
      "description": "The image of the helpers of the test environment runs the compiled main with the Node of .nvmrc: it moves with .nvmrc, by hand, in the same pull request.",
      "matchManagers": ["nvm"],
      "prBodyNotes": [
        "This pull request moves the Node of `.nvmrc`. The image of the helpers of the test environment, `docker.io/library/node` in `e2e/scripts/local-manifests.mts`, moves with it by hand: its tag to the same version, its digest to the one of the index the registry gives for that tag, and the version the direct proof checks in `e2e/scripts/local-demo.mts`. Then run the transport proof, `pnpm e2e`, in its four modes."
      ]
    },
    {
      "description": "The Node runtime of Trunk takes the version in mise.toml of Freelens on main, like the one in mise.toml here. The custom datasource has no release dates, so minimumReleaseAge is off.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".trunk/trunk.yaml"],
      "matchDepNames": ["node"],
      "overrideDatasource": "custom.freelens-mise",
      "overridePackageName": "{{depName}}",
      "rangeStrategy": "replace",
      "minimumReleaseAge": "0 days",
      "groupName": "Freelens dependencies"
    },
    {
      "description": "No updates of engines.node, the oldest Node the extension runs on, which Freelens keeps as a range too. engines.freelens is updated by the custom manager for it.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "Group @freelensapp/* with everything that follows Freelens into one PR, so that a nightly of @freelensapp/extensions and the stack it was built with arrive together.",
      "matchPackageNames": ["@freelensapp/**"],
      "groupName": "Freelens dependencies"
    },
    {
      "description": "peerDependencies are widened.",
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen",
      "semanticCommitScope": "peer-deps"
    },
    {
      "description": [
        "peerDependencies are not bumped by vulnerability fixes either.",
        "Renovate turns every vulnerability alert into a package rule appended after these ones, with the vulnerabilityAlerts settings in its force object. Forced settings override every other rule, so vulnerabilityAlerts.rangeStrategy replaces the widen strategy above, and no package rule can put it back.",
        "Package rules are applied again to each update after the lookup, when the update already carries isVulnerabilityAlert. This rule drops the peer range change from the fix at that point, while the other dependencies in the same fix keep the bump strategy."
      ],
      "matchDepTypes": ["peerDependencies"],
      "matchJsonata": ["isVulnerabilityAlert = true"],
      "enabled": false
    },
    {
      "description": "Non-major updates only.",
      "matchDepNames": ["npm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "The pins of the test environment.",
      "matchFileNames": ["e2e/scripts/**"],
      "prBodyNotes": [
        "This is a pin of the test environment. Before merging, run the upstream drift watch of `docs/development/PROCESS.md` for the version it moves to, and wait for the E2E tests: they bring the environment up with the new pin on the hosted runner."
      ]
    },
    {
      "description": "The versions of Velero and of its plugin are the ones the specs were reviewed against.",
      "matchFileNames": ["e2e/scripts/**"],
      "matchDepNames": ["velero/velero", "velero/velero-plugin-for-aws"],
      "groupName": "velero",
      "prBodyNotes": [
        "The types and the specs of the extension were written from the CRD schemas of the pinned Velero. A new version needs its schemas compared and the reviewed tag and commit recorded in `docs/development/RECON-T0.1.md` and in the affected specs."
      ]
    },
    {
      "description": "The helper runs the compiled main: its Node.js is the one of .nvmrc and moves with it, by hand.",
      "matchFileNames": ["e2e/scripts/**"],
      "matchDepNames": ["library/node"],
      "enabled": false
    },
    {
      "description": "kind, its node image and kubectl move together: kubectl stays within one minor version of the node.",
      "matchFileNames": ["e2e/scripts/**"],
      "matchDepNames": ["kindest/node", "kubernetes-sigs/kind", "kubernetes/kubernetes"],
      "groupName": "kind"
    },
    {
      "description": "Renovate moves the version, not the checksums pinned beside it.",
      "matchFileNames": ["e2e/scripts/local-platform.mts"],
      "prBodyNotes": [
        "The checksums of the four targets are pinned beside the version and this pull request does not change them: replace them with the ones the release publishes. The environment is not installed until they match."
      ]
    }
  ],
  "customDatasources": {
    "freelens-catalog": {
      "description": "The version of a library in the default catalog of Freelens on main.",
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/freelensapp/freelens/main/pnpm-workspace.yaml",
      "format": "yaml",
      "transformTemplates": ["{\"releases\": [{\"version\": catalog.`{{{packageName}}}`}]}"]
    },
    "freelens-dlx": {
      "description": "The version of a tool that a script in the root package.json of Freelens on main runs with pnpm dlx: the text after `dlx <name>@` up to the next space or the end of the script.",
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/freelensapp/freelens/main/package.json",
      "format": "json",
      "transformTemplates": [
        "($scripts := $join($each(scripts, function($v) { $v }), \"\\n\"); $marker := \"dlx {{{packageName}}}@\"; {\"releases\": $contains($scripts, $marker) ? [{\"version\": $split($substringBefore($substringAfter($scripts, $marker), \"\\n\"), \" \")[0]}] : []})"
      ]
    },
    "freelens-mise": {
      "description": "The version of a tool in mise.toml of Freelens on main.",
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/freelensapp/freelens/main/mise.toml",
      "format": "toml",
      "transformTemplates": ["{\"releases\": [{\"version\": tools.`{{{packageName}}}`}]}"]
    }
  },
  "customManagers": [
    {
      "description": "The freelens engine field in package.json.",
      "customType": "regex",
      "extractVersionTemplate": "^(?<version>.*)$",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": ["\"freelens\"\\s*:\\s*\"(?<currentValue>\\S+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "freelensapp/freelens",
      "versioningTemplate": "npm"
    },
    {
      "description": "Tools run with pnpm dlx.",
      "customType": "regex",
      "extractVersionTemplate": "^(?<version>.*)$",
      "managerFilePatterns": ["/package\\.json$/"],
      "matchStrings": ["pnpm\\s+dlx\\s+(?<depName>\\S+)@(?<currentValue>\\S+?)[\\s\"|<>]"],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "description": "The images of the test environment, pinned by tag and digest.",
      "customType": "regex",
      "managerFilePatterns": ["/^e2e/scripts/local-manifests\\.mts$/"],
      "matchStrings": [
        "\"docker\\.io/(?<depName>[a-z0-9./-]+):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "kind, a binary of the test environment, pinned by version and checksum.",
      "customType": "regex",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "managerFilePatterns": ["/^e2e/scripts/local-platform\\.mts$/"],
      "matchStrings": ["kind: \\{\\s*version: \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/kind",
      "versioningTemplate": "semver"
    },
    {
      "description": "kubectl, a binary of the test environment, pinned by version and checksum.",
      "customType": "regex",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "managerFilePatterns": ["/^e2e/scripts/local-platform\\.mts$/"],
      "matchStrings": ["kubectl: \\{\\s*version: \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes",
      "versioningTemplate": "semver"
    },
    {
      "description": "Renovate hints in a comment after the version.",
      "customType": "regex",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/", "/^\\.trunk/trunk.yaml$/", "/^\\.tool-versions$/"],
      "matchStrings": [
        "(\\s+|.*?@)(?<currentValue>\\S+?)!?\\s*#\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+versioning=(?<versioning>\\S+))?(\\s+registryUrl=(?<registryUrl>\\S+))?\\s*\\n"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
